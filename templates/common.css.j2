@font-face { font-family: 'Caprasimo'; font-weight: 400; src: url('fonts/Caprasimo-400.ttf'); }
@font-face { font-family: 'Figtree'; font-weight: 300; src: url('fonts/Figtree-300.ttf'); }
@font-face { font-family: 'Figtree'; font-weight: 400; src: url('fonts/Figtree-400.ttf'); }
@font-face { font-family: 'Figtree'; font-weight: 500; src: url('fonts/Figtree-500.ttf'); }
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; background: {{ p.ground }}; }
body { font-family: 'Figtree', sans-serif; font-weight: 400; color: {{ p.text }}; }
.cap { font-family: 'Caprasimo', serif; font-weight: 400; }
