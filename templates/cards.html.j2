<!doctype html>
<html><head><meta charset="utf-8"><title>{{ tt.student }} Cards</title>
<style>
{% include 'common.css.j2' %}
@page { size: A4 portrait; margin: 0; background: #fff; }
html, body { background: #fff; }
.sheet { position: relative; width: 210mm; height: 297mm; overflow: hidden; }
.sheet + .sheet { page-break-before: always; }
.card { position: absolute; width: {{ card.w }}mm; height: {{ card.h }}mm; border: 0.2px dashed #a19786;
        background: {{ p.ground }}; overflow: hidden; }
.inner { padding: 8px 8px 8px 8px; }
.hd { display: flex; align-items: center; gap: 6px; height: 20px; margin-bottom: 5px; }
.hd .day { font-size: 16px; line-height: 1; }
.pillw { background: {{ p.accent }}; color: {{ p.ground }}; border-radius: 999px; padding: 1px 7px; font-size: 8.5px;
         font-weight: 500; line-height: 13px; }
.pillw.s { background: {{ p.sage }}; }
.hd .mv { margin-left: auto; font-size: 8.5px; font-weight: 400; color: {{ p.grey2 }}; white-space: nowrap; }
.body { display: flex; gap: 5px; }
.rows { flex: 1; min-width: 0; }
.r { display: flex; align-items: center; height: {{ card.row }}px; margin-bottom: {{ card.row_gap }}px; border-radius: 8px;
     padding: 0 3px 0 6px; gap: 4px; border: 1px solid transparent; }
.r .t { width: 24px; flex: none; font-size: 8px; font-weight: 300; }
.r .s { flex: none; max-width: 78px; font-size: 8.5px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.r .te { flex: 1; min-width: 0; font-size: 7.5px; font-weight: 300; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.r .chip { flex: none; color: #fff; border-radius: 999px; padding: 0 5px; font-size: 7.5px; font-weight: 500; line-height: 13px; }
.g { height: {{ card.gap }}px; margin-bottom: {{ card.row_gap }}px; border-radius: 999px; background: {{ p.pill }};
     font-size: 7.5px; font-weight: 400; line-height: {{ card.gap }}px; text-align: center; color: {{ p.grey }}; }
.rows > :last-child { margin-bottom: 0; }
.strip { flex: none; width: {{ card.strip_w }}px; height: {{ card.strip_h }}px; background: {{ p.green }};
         border-radius: 12px; position: relative; overflow: hidden; }
.strip .lg { position: absolute; left: 50%; top: 50%; width: {{ card.logo_len }}px; height: {{ card.logo_thick }}px;
             margin: -{{ card.logo_thick / 2 }}px 0 0 -{{ card.logo_len / 2 }}px; transform: rotate(-90deg); }
.strip .lg img { display: block; width: 100%; height: 100%; }
/* backs */
.lp { background: {{ p.green }}; border-radius: 999px; padding: 4px 8px; flex: none; }
.lp img { display: block; height: 11px; }
.ttl { min-width: 0; flex: 1; }
.pack { font-size: 16px; line-height: 1; }
.sub { font-size: 8px; font-weight: 300; margin-top: 3px; color: {{ p.grey2 }}; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.lists { display: flex; gap: 10px; margin-top: 11px; }
.lists ul { list-style: none; margin: 0; padding: 0; flex: 1; min-width: 0; }
.lists li { display: flex; align-items: center; gap: 6px; height: 22px; font-size: 9.5px; font-weight: 400; white-space: nowrap; }
.lists .bx { flex: none; width: 11px; height: 11px; border: 1px solid {{ p.grey }}; border-radius: 3px; background: #fff; }
</style></head><body>
{# ---------- fronts: left column Week A, right column Week B ---------- #}
<div class="sheet"><div style="position:absolute;left:{{ card.margin_x }}mm;top:{{ card.margin_y }}mm;width:{{ card.w * card.cols }}mm;height:{{ card.h * card.rows }}mm">
{% for i in range(5) %}{% for col in range(2) %}
  {% set wk = 'A' if col == 0 else 'B' %}{% set d = weeks[wk][days[i]] %}
  <div class="card" data-label="front {{ wk }} {{ d.short }}" style="left:{{ col * card.w }}mm;top:{{ i * card.h }}mm"><div class="inner">
    <div class="hd"><span class="day cap">{{ d.name }}</span><span class="pillw">Week {{ wk }}</span>
      <span class="mv">{{ d.moves }} block move{{ '' if d.moves == 1 else 's' }}</span></div>
    <div class="body"><div class="rows">
      {% for it in d['items'] %}{% if it.gap %}<div class="g">{{ it.label }} {{ it.start }}–{{ it.end }}</div>
      {% else %}<div class="r" style="background:{{ it.fill }};{% if it.border %}border:1px dashed {{ it.border }};{% endif %}">
        <span class="t">{{ it.start }}</span><span class="s">{{ it.subject }}</span><span class="te">{{ it.teacher }}</span>{% if it.room %}<span class="chip" style="background:{{ it.chip }}">{{ it.room }}</span>{% endif %}</div>{% endif %}{% endfor %}
    </div>
    <div class="strip"><div class="lg"><img src="{{ logo }}"></div></div></div>
  </div></div>
{% endfor %}{% endfor %}
</div></div>
{# ---------- backs: mirrored left<->right so each kit list sits behind its day (flip on long edge) ---------- #}
<div class="sheet"><div style="position:absolute;left:{{ card.margin_x }}mm;top:{{ card.margin_y }}mm;width:{{ card.w * card.cols }}mm;height:{{ card.h * card.rows }}mm">
{% for i in range(5) %}{% for col in range(2) %}
  {% set wk = 'B' if col == 0 else 'A' %}{% set d = weeks[wk][days[i]] %}
  {% set items = d.kit['items'] %}{% set half = (items | length + 1) // 2 %}
  <div class="card" data-label="back {{ wk }} {{ d.short }}" style="left:{{ col * card.w }}mm;top:{{ i * card.h }}mm"><div class="inner">
    <div class="hd"><div class="lp"><img src="{{ logo }}"></div>
      <div class="ttl"><div class="pack cap">Pack for {{ d.name }}</div>
        <div class="sub">{% if show_name %}{{ tt.student }} · {% endif %}{{ tt.tutor_group }}</div></div>
      <span class="pillw s">Week {{ wk }}</span></div>
    <div class="lists">
      <ul>{% for x in items[:half] %}<li><span class="bx"></span>{{ x }}</li>{% endfor %}</ul>
      <ul>{% for x in items[half:] %}<li><span class="bx"></span>{{ x }}</li>{% endfor %}</ul>
    </div>
  </div></div>
{% endfor %}{% endfor %}
</div></div>
</body></html>
